# Copia este archivo como .env y completa los valores. Luego ejecuta:  node scripts/configurar.mjs
# (eso reescribe js/config.js, que es lo que usa la app en el navegador)
#
# Ambos valores son PÚBLICOS por diseño de Supabase (van en el navegador).
# Los encuentras en Supabase → Project Settings → API.

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=pega-aqui-la-clave-anon-publica

# NUNCA pongas aquí ni en ningún archivo del repositorio la "service_role key".
# La función cg-media la recibe automáticamente dentro de Supabase.
